{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "WebWorker"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["worker/**/*.ts", "src/contact/**/*.ts"]
}
