{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aimansour-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "aimansour.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/contact"]
  },
  "send_email": [{ "name": "CONTACT_EMAIL", "destination_address": "abdullahmansour.marketing@gmail.com" }],
  "ratelimits": [{ "name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "enabled": true, "invocation_logs": false } }
}
