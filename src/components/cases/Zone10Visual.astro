---
import { Image } from 'astro:assets';
import type { SiteContent, Locale } from '../../content/contracts.ts';
import { getEvidenceImage } from '../../lib/assets.ts';
import Metric from '../Metric.astro';
interface Props { content: SiteContent; locale: Locale }
const { content, locale } = Astro.props;
const desktop = content.evidence['zone-desktop']!; const mobile = content.evidence['zone-mobile']!;
const flow = locale === 'ar' ? ['طلب في البحث','حملات Google Ads','صفحات مخصصة','تواصل مع المبيعات'] : ['Search demand','Google Ads','Dedicated pages','Contact with sales'];
---
<section class="case-visual zone-visual" aria-label={locale === 'ar' ? 'رحلة اكتساب العملاء في Zone10' : 'The Zone10 acquisition journey'}>
  <ol class="acquisition-flow">{flow.map(step => <li>{step}</li>)}</ol>
  <div class="zone-montage"><div class="zone-desktop"><Image src={getEvidenceImage(desktop)} alt={desktop.alt[locale]} width={1100} widths={[600,1100]} sizes="(max-width:760px) 78vw, 900px" format="webp" loading="eager" fetchpriority="high" quality={85}/></div><div class="zone-mobile"><Image src={getEvidenceImage(mobile)} alt={mobile.alt[locale]} width={350} format="webp" loading="eager" quality={85}/></div></div>
  <dl class="case-metrics">
    {['zone10.contacts','zone10.active-months','zone10.campaigns'].map(id => <Metric metric={content.metrics[id]!} locale={locale}/>)}
    <div class="case-metric zone-spend"><dt>{content.metrics['zone10.spend']!.label[locale]}</dt><dd class="mono" dir="ltr">{content.metrics['zone10.spend']!.display[locale]}<span class="zone-spend-equivalent">{content.metrics['zone10.spend-usd']!.display[locale]}</span></dd></div>
  </dl>
</section>

<style>
  .zone-spend dd{font-size:clamp(1.65rem,3vw,2.5rem)}
  .zone-spend-equivalent{display:block;font-size:1rem;line-height:1.4;margin-block-start:.4rem;color:var(--secondary)}
  @media(max-width:760px){.zone-spend dd{font-size:1.4rem}}
</style>
