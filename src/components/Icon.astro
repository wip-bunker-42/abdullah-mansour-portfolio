---
interface Props { name: 'arrow' | 'sun' | 'moon' | 'menu' | 'download' | 'external'; size?: number; class?: string }
const { name, size = 20, class: className } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={className}>
  {name === 'arrow' && <><path d="M5 12h14M13 6l6 6-6 6" /></>}
  {name === 'external' && <><path d="M7 17 17 7M7 7h10v10" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></>}
  {name === 'moon' && <path d="M20.6 13.2A8.6 8.6 0 0 1 10.8 3.4a8.6 8.6 0 1 0 9.8 9.8Z"/>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16"/>}
  {name === 'download' && <><path d="M12 3v12m-4-4 4 4 4-4M5 16v5h14v-5"/></>}
</svg>
