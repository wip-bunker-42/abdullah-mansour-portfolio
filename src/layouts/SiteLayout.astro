---
import type { Route } from '../content/contracts.ts';
import { t } from '../i18n/messages.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { themeBootstrap } from '../scripts/theme.ts';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/layout.css';
interface Props { route: Route; title: string; description: string; noindex?: boolean }
const { route, title, description, noindex = !route.indexable } = Astro.props;
---
<!doctype html>
<html lang={route.locale} dir={route.locale === 'ar' ? 'rtl' : 'ltr'} data-theme="dark">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <script is:inline set:html={themeBootstrap}/>
    <title>{title}</title><meta name="description" content={description}/>
    <meta name="theme-color" content="#0B0D10"/>
    {noindex && <meta name="robots" content="noindex"/>}
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/>
    <link rel="icon" href="/brand/favicon.ico" sizes="any"/>
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/>
    <link rel="preload" href={route.locale === 'ar' ? '/fonts/ibm-plex-sans-arabic-arabic-400-normal.woff2' : '/fonts/ibm-plex-sans-latin-400-normal.woff2'} as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href={route.locale === 'ar' ? '/fonts/ibm-plex-sans-arabic-arabic-500-normal.woff2' : '/fonts/ibm-plex-sans-latin-500-normal.woff2'} as="font" type="font/woff2" crossorigin/>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(route.locale).skip}</a>
    <Header route={route}/><main id="main" tabindex="-1"><slot/></main><Footer locale={route.locale}/>
    <script>
      import { initializeTheme } from '../scripts/theme.ts';
      import { initializeNavigation } from '../scripts/navigation.ts';
      initializeTheme(); initializeNavigation();
    </script>
  </body>
</html>
