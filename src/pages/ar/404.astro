---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ErrorPage from '../../views/ErrorPage.astro';
import { getRoute } from '../../i18n/routes.ts';
import { t } from '../../i18n/messages.ts';
const route = { ...getRoute('error','ar'), path: '/ar/404.html' };
---
<SiteLayout route={route} title={t('ar').utility.notFound.title} description={t('ar').utility.notFound.description}><ErrorPage locale="ar" kind="not-found"/></SiteLayout>
