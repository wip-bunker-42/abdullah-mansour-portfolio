---
import { Picture } from 'astro:assets';
import type { SiteContent, RenderedDocument, Locale } from '../content/contracts.ts';
import portrait from '../assets/portrait/abdullah-mansour-transparent.png';
import { getRoute } from '../i18n/routes.ts';
import { t } from '../i18n/messages.ts';
import CvLink from '../components/CvLink.astro';
import WorkRow from '../components/WorkRow.astro';
interface Props { content: SiteContent; document: RenderedDocument; locale: Locale }
const { content, document, locale } = Astro.props;
const m = t(locale);
const section = (id: string) => document.sections.find(s => s.id === id);
const selected = content.projects.filter(p => p.published && p.featured).sort((a,b) => a.order - b.order);
const metrics = ['tahliq.meta.customers', 'zone10.customer-conversion', 'elkhabar.views', 'sorouh.pages'].map(id => content.metrics[id]!);
const approach = section('approach'); const ai = section('ai'); const experience = section('experience'); const next = section('next');
---
<div class="container">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="hero-name">{content.profile.name[locale]}</p>
      <p class="hero-role"><bdi lang="en">{content.profile.professionalTitle.en}</bdi></p>
      <h1 id="hero-heading">{document.heading}</h1>
      <p class="hero-lead">{document.lead}</p>
      <div class="actions"><a href={getRoute('work', locale).path} class="button button--primary">{m.work}</a><CvLink locale={locale}/></div>
    </div>
    <figure class="portrait">
      <div class="portrait-image"><Picture src={portrait} alt={content.profile.name[locale]} widths={[360, 520, 740, 880]} sizes="(max-width:760px) 90vw, 440px" width={880} formats={['avif']} fallbackFormat="webp" quality={65} loading="eager"/></div>
      <figcaption><span>{m.location}</span><span>{locale === 'ar' ? 'بحث. تنفيذ. تحسين.' : 'Research. Delivery. Improvement.'}</span></figcaption>
    </figure>
  </section>
  <section aria-label={m.results}><dl class="results">{metrics.map(metric => <div class="result"><dt>{metric.label[locale]}</dt><dd class="mono" dir="ltr">{metric.display[locale]}</dd></div>)}</dl></section>
  {approach && <section class="section insight" aria-labelledby="approach-heading"><h2 id="approach-heading">{approach.heading}</h2><div><div class="prose" set:html={approach.html}/><a class="text-link" href={`${getRoute('resume', locale).path}#experience`}>{m.experience}</a></div></section>}
  {selected.length > 0 && <section class="section" data-selected-work aria-labelledby="selected-heading">
    <div class="section-header"><div><h2 id="selected-heading">{m.selected}</h2><p>{m.selectedIntro}</p></div><a class="text-link" href={getRoute('work', locale).path}>{m.allWork}</a></div>
    <div>{selected.map((project, i) => <WorkRow project={project} content={content} locale={locale} reverse={i === 1}/>)}</div>
  </section>}
  {ai && <section class="section capability-section" aria-labelledby="ai-heading"><div><h2 id="ai-heading">{ai.heading}</h2><ul class="capabilities">{content.experience.capabilities.slice(0,6).map(c => <li>{c.name[locale]}</li>)}</ul></div><div class="prose" set:html={ai.html}/></section>}
  {experience && <section class="section experience-summary" aria-labelledby="experience-heading"><div><h2 id="experience-heading">{experience.heading}</h2><p class="muted">{content.experience.positions.map(p => p.organization[locale]).join(' · ')}</p></div><a class="text-link" href={getRoute('resume', locale).path}>{m.experience}</a></section>}
  <section class="home-closing" aria-labelledby="closing-heading"><h2 id="closing-heading">{next?.heading || m.footer}</h2>{next && <div class="prose" set:html={next.html}/>}<a class="button button--primary" href={getRoute('contact', locale).path}>{m.contact}</a></section>
</div>
