---
import type { SiteContent, RenderedDocument, Locale } from '../content/contracts.ts';
import { getPublishedProjects } from '../content/publication.ts';
import { getRoute } from '../i18n/routes.ts';
import { t } from '../i18n/messages.ts';
import WorkRow from '../components/WorkRow.astro';
import CvLink from '../components/CvLink.astro';
import '../styles/work.css';
interface Props { content: SiteContent; document: RenderedDocument; locale: Locale }
const {content,document,locale}=Astro.props;const m=t(locale);const projects=getPublishedProjects(content);
---
<div class="container work-page"><header class="page-intro"><h1>{document.heading}</h1><p>{document.lead}</p></header>
  {projects.length ? projects.map((project,i)=><WorkRow project={project} content={content} locale={locale} reverse={i%2===1} headingLevel="h2"/>) : <section class="empty-work"><h2>{locale==='ar'?'أُجهّز عرضًا محدّثًا للأعمال.':'An updated selection of work is on its way.'}</h2><p>{locale==='ar'?'يمكنك مراجعة خبراتي أو التواصل معي لمناقشة ما يحتاجه فريقك.':'You can review my experience or contact me to discuss what your team needs.'}</p><div class="actions"><a class="button button--primary" href={getRoute('contact',locale).path}>{m.nav.contact}</a><CvLink locale={locale}/></div></section>}
  <section class="work-end"><h2>{m.footer}</h2><a class="button button--primary" href={getRoute('contact',locale).path}>{m.contact}</a></section>
</div>
