{
  "name": "aimansour-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/publish-assets.ts --dev && astro dev --host 127.0.0.1",
    "build": "astro build && tsx scripts/publish-assets.ts",
    "check": "astro sync && astro check",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "astro": "7.4.0",
    "gray-matter": "4.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "parse5": "8.0.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.151.1"
  }
}
